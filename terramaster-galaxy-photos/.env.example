# Copy to .env and edit. Keep .env out of git (see .gitignore).

# --- Where Immich stores its own data on the NAS ---
UPLOAD_LOCATION=/Volume1/galaxy/immich-upload
DB_DATA_LOCATION=/Volume1/galaxy/immich-db

# --- Your EXISTING photo folder on the NAS (mounted read-only as an "external library") ---
PHOTO_LIBRARY=/Volume1/Photos

# --- Immich database ---
DB_PASSWORD=change-me-to-a-long-random-string
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# --- Created in the Immich web UI after first launch: Account -> API Keys ---
IMMICH_API_KEY=paste-your-immich-api-key-here

# Pin a release instead of tracking 'release' if you want reproducible deploys, e.g. v1.119.0
IMMICH_VERSION=release
